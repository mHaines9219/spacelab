{
  "_format": "Input to `npm run ingest:build`. One entry per curated master in web/assets-src/. Records BOTH provenance (source/license/attribution) and the manual geometry tags the constraint solver needs (real-world size, front orientation, anchor). Drop a new .glb in assets-src/, add an entry here, rebuild.",
  "_fields": {
    "id": "stable catalog id (also the normalised filename in models/)",
    "file": "master filename in assets-src/",
    "title": "human name",
    "source": "where it came from, e.g. 'Quaternius (CC0)'",
    "source_url": "canonical origin URL",
    "license": "SPDX-ish string, e.g. 'CC0-1.0'",
    "attribution": "credit string, or null when the licence needs none (CC0)",
    "sizeMeters": "real-world length along sizeAxis. OMIT for already-real-scaled sources (keeps native size)",
    "sizeAxis": "x | y | z that sizeMeters measures (default y = height)",
    "yawDeg": "degrees about +Y so the model's front faces +Z (default 0)",
    "anchor": "floor | wall (default floor)",
    "category": "catalog category",
    "tags": "free-text search tags",
    "clearance_m": "optional { front, sides, back } clearance envelope in metres"
  },
