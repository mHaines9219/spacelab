target/
node_modules/
# ...and as a symlink: worktrees often link to a sibling's, and `node_modules/`
# with the trailing slash matches directories only, so the link itself slips through.
node_modules
dist/
pkg/
web/src/wasm/
web/public/assets/textures/
web/public/assets/models/
web/assets-src/_kenney/
web/assets-src/_polyhaven/
# Re-fetchable masters (Poly Haven etc.) — regenerated from tags.json `fetch` descriptors
# by ingest, so the catalog isn't bounded by git weight. See scripts/fetch-master.mjs.
web/assets-src/_cache/
*.wasm
.DS_Store
.env
.env.local
web/test-results/
web/playwright-report/
